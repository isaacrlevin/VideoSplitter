    private async Task GenerateSocialMediaContent()
    {
        if (project == null || selectedSegmentForDescription == null || isGeneratingContent)
            return;

        try
        {
            isGeneratingContent = true;
            contentGenerationError = "";
            StateHasChanged();

            // Reload the segment from the database to ensure we have the latest transcript text
            // This is important because the transcript may have been updated during clip extraction
            var refreshedSegment = await SegmentService.GetSegmentByIdAsync(selectedSegmentForDescription.Id);
            if (refreshedSegment == null)
            {
                contentGenerationError = "Segment not found. Please refresh the page.";
                return;
            }

            // Use only the segment's transcript text for generating the description
            // This ensures the title and description are based on the specific clip, not the entire video
            string? transcriptContent = refreshedSegment.TranscriptText;

            if (string.IsNullOrEmpty(transcriptContent))
            {
                contentGenerationError = "No transcript available for this segment. Extract the clip with subtitles enabled to generate a transcript, or the clip may still be processing.";
                return;
            }

            // Get user settings
            var settings = await SettingsService.GetSettingsAsync();

            var progress = new Progress<string>(status =>
            {
                // Could update UI with status if needed
                Console.WriteLine($"AI Content Generation: {status}");
            });

            // Call AI service for channel-neutral copy that can be reused for every platform
            var result = await AiService.GenerateSocialMediaContentAsync(
                transcriptContent,
                settings,
                progress);

            if (result.Success && !string.IsNullOrEmpty(result.Title))
            {
                // Autofill the title and description
                descriptionTitle = result.Title;
                if (!string.IsNullOrEmpty(result.Description))
                {
                    descriptionBody = result.Description;
                }
                contentGenerationError = "";
                descriptionSaveStatus = "";
            }
            else
            {
                contentGenerationError = result.Error ?? "Failed to generate content";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error generating social media content: {ex.Message}");
            contentGenerationError = $"Error: {ex.Message}";
        }
        finally
        {
            isGeneratingContent = false;
            StateHasChanged();
        }
    }

    private async Task ConnectToPlatform()
    {
        var publisher = SocialMediaPublisherService.GetPublisher(selectedPlatformName);
        if (publisher == null)
        {
            publishError = $"Publisher for {selectedPlatformName} not found.";
            return;
        }

        try
        {
            isConnecting = true;
            publishError = "";
            StateHasChanged();

            // The publisher handles everything: starting local listener, opening browser, waiting for callback
            var result = await publisher.AuthenticateAsync(
                timeout: TimeSpan.FromMinutes(5));

            if (result.Success)
            {
                publisherAuthStatus[selectedPlatformName] = true;
                publishError = "";
            }
            else
            {
                publishError = result.Error ?? "Authentication failed. Please try again.";
            }

            // Refresh auth status for all publishers
            publisherAuthStatus = await SocialMediaPublisherService.GetAuthenticationStatusAsync();
        }
        catch (Exception ex)
        {
            publishError = $"Failed to connect: {ex.Message}";
        }
        finally
        {
            isConnecting = false;
            StateHasChanged();
        }
    }

    private async Task PublishToSelectedPlatform()
    {
        if (selectedSegmentForPost == null || string.IsNullOrEmpty(selectedSegmentForPost.ClipPath))
        {
            publishError = "No clip selected for publishing.";
            return;
        }

        var publisher = SocialMediaPublisherService.GetPublisher(selectedPlatformName);
        if (publisher == null)
        {
            publishError = $"Publisher for {selectedPlatformName} not found.";
            return;
        }

        try
        {
            isPublishing = true;
            publishError = "";
            publishSuccess = "";
            publishedUrl = "";
            publishStatus = "Preparing upload...";
            StateHasChanged();

            // Parse hashtags
            var tags = string.IsNullOrWhiteSpace(postHashtags)
                ? new List<string>()
                : postHashtags.Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Select(t => t.Trim().TrimStart('#'))
                    .Where(t => !string.IsNullOrWhiteSpace(t))
                    .ToList();

            var request = new PublishRequest
            {
                VideoPath = selectedSegmentForPost.ClipPath,
                Title = postTitle,
                Description = postDescription,
                Tags = tags,
                Privacy = postPrivacy,
                AllowComments = allowComments,
                AllowDuet = allowDuet,
                AllowStitch = allowStitch
            };

            var progress = new Progress<double>(p =>
            {
                publishProgress = p;
                publishStatus = p switch
                {
                    < 0.2 => "Initializing upload...",
                    < 0.8 => "Uploading video...",
                    < 1.0 => "Finalizing...",
                    _ => "Complete!"
                };
                InvokeAsync(StateHasChanged);
            });

            var result = await publisher.PublishVideoAsync(request);

            if (result.Success)
            {
                publishSuccess = $"Successfully published to {selectedPlatformName}!";
                publishedUrl = result.PostUrl ?? "";
                publishStatus = "Published successfully!";
            }
            else
            {
                publishError = result.Error ?? "Unknown error occurred during publishing.";

                // If this was a token error, the account has been disconnected - refresh auth status
                if (result.IsTokenError)
                {
                    publisherAuthStatus = await SocialMediaPublisherService.GetAuthenticationStatusAsync();
                }
            }
        }
        catch (Exception ex)
        {
            publishError = $"Publishing failed: {ex.Message}";
        }
        finally
        {
            isPublishing = false;
            StateHasChanged();
        }
    }
