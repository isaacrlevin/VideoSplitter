    private bool IsEditSegmentValid()
    {
        var startTs = ParseTimeSpan(editSegmentStartTime);
        var endTs = ParseTimeSpan(editSegmentEndTime);

        if (!startTs.HasValue || !endTs.HasValue)
            return false;

        if (endTs.Value <= startTs.Value)
            return false;

        if (project?.Duration.HasValue == true && endTs.Value > project.Duration.Value)
            return false;

        return true;
    }

    private async Task InitializeEditSegmentVideoPlayer()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("initializeEditSegmentVideoPlayer", dotNetObjectRef);

            // Seek to the start time of the segment
            var startTs = ParseTimeSpan(editSegmentStartTime);
            if (startTs.HasValue)
            {
                await JSRuntime.InvokeVoidAsync("seekEditSegmentVideoToTime", startTs.Value.TotalSeconds);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error initializing edit segment video player: {ex.Message}");
        }
    }

    private async Task PreviewEditedSegment()
    {
        var startTs = ParseTimeSpan(editSegmentStartTime);
        var endTs = ParseTimeSpan(editSegmentEndTime);

        if (!startTs.HasValue || !endTs.HasValue || endTs.Value <= startTs.Value)
            return;

        try
        {
            // Seek to start time and play
            await JSRuntime.InvokeVoidAsync("playEditSegmentRange", startTs.Value.TotalSeconds, endTs.Value.TotalSeconds);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error previewing segment: {ex.Message}");
        }
    }

    private async Task SaveEditSegment()
    {
        if (segmentForEdit == null || !IsEditSegmentValid())
            return;

        try
        {
            var startTs = ParseTimeSpan(editSegmentStartTime);
            var endTs = ParseTimeSpan(editSegmentEndTime);

            if (!startTs.HasValue || !endTs.HasValue)
                return;

            // Update the segment's timestamps
            segmentForEdit.StartTime = startTs.Value;
            segmentForEdit.EndTime = endTs.Value;

            // If the segment was already extracted, mark it as needing re-extraction
            // by changing status back to Approved
            if (segmentForEdit.Status == SegmentStatus.Extracted)
            {
                segmentForEdit.Status = SegmentStatus.Approved;
                // Note: We're not deleting the old clip file here to preserve it
                // The user can choose to extract again with the new timestamps
            }

            // Save the updated segment to the database
            await SegmentService.UpdateSegmentAsync(segmentForEdit);

            // Close the modal
            showEditSegmentModal = false;
            segmentForEdit = null;
            editSegmentStartTime = string.Empty;
            editSegmentEndTime = string.Empty;

            // Reload segments to reflect the changes
            await LoadProject();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving segment edits: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"Failed to save segment changes: {ex.Message}");
        }
    }

